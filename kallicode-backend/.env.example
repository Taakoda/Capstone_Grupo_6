# .env.example
# Copia este archivo a .env y ajusta los valores para tu entorno local.

# Conexión de APLICACIÓN: usada por sesion_tenant() para todo el tráfico
# normal de la API. El rol de este usuario NO debe tener BYPASSRLS —
# así las políticas RLS por tenant se aplican siempre.
KC_DATABASE_URL=postgresql+asyncpg://kallicode_app_local:dev@localhost:5432/kallicode

# Conexión ADMINISTRATIVA: usada solo por sesion_sistema() para tareas
# que cruzan tenants (migraciones, jobs de sistema, scheduler, billing_cycle,
# housekeeping). Este rol SÍ puede tener privilegios elevados.
# Obligatoria en todo entorno — el arranque falla sin ella.
KC_DATABASE_URL_ADMIN=postgresql+asyncpg://kallicode_admin_local:dev@localhost:5432/kallicode